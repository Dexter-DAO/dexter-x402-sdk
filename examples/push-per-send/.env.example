# ── Server ───────────────────────────────────────────────────────────────────
PORT=4880

# Any Solana mainnet RPC. Used once per tab session, never per send.
# Use a real provider (Helius etc.) in production.
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Where the USDC lands. Receive-only pubkey; no key material on the server.
# Default is Dexter's demo seller — set YOUR payout pubkey before going live.
SELLER_PAYTO=FKF63wLt122SLDNPBfpDgrMcQzxtdLfLyrUS1KziRR1h

# Delivery seam: 'live' calls the dexter-api notify relay, 'mock' logs the
# page locally so you can run the whole payment flow with zero secrets.
DELIVERY_MODE=mock

# Live delivery only: the dexter-api base URL and its internal service token.
DEXTER_API_BASE=https://api.dexter.cash
DEXTER_INTERNAL_TOKEN=

# ── Buyer snippet ────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:4880/send

# Where the page goes: telegram chat id (channel 'telegram') or email address.
PAGE_CHANNEL=telegram
PAGE_TO=
PAGE_MESSAGE=Paged you from the push-per-send example.

# oneshot: a Solana keypair holding a little USDC + SOL.
# Base58 string or solana-keygen JSON array. Leave empty to dry-run with an
# unfunded throwaway key (shows the failure shape, pays nothing).
BUYER_SOLANA_SECRET_KEY=

# tab: Dexter Vault credentials (the agent rail). All five required.
VAULT_SWIG_ADDRESS=
VAULT_PDA=
VAULT_PASSKEY_PUBLIC_KEY_B64=
VAULT_PASSKEY_PRIVATE_KEY_B64=
# solana-keygen JSON array; pays the (tiny) tx fees for tab open/close.
FEE_PAYER_SECRET_KEY=

# Optional managed reservation service (default https://x402.dexter.cash).
# FINAL V2 waits for this service to prove the exact reservation finalized.
# This buyer is a server-side CLI. Never expose the internal token in a browser;
# browser apps must proxy this money-side call through an authenticated backend.
#FACILITATOR_URL=https://x402.dexter.cash
#TAB_OPEN_INTERNAL_TOKEN=

# ── Server ──────────────────────────────────────────────────────────────────

# REQUIRED (one of the two). The demo serves REAL inference — the server
# refuses to boot without a provider key. If both are set, Anthropic wins;
# override with INFERENCE_PROVIDER.
#   ANTHROPIC_API_KEY -> claude-haiku-4-5   (https://console.anthropic.com/)
#   OPENAI_API_KEY    -> gpt-5.4-nano       (https://platform.openai.com/)
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# Optional. Force the backing provider: anthropic | openai.
#INFERENCE_PROVIDER=anthropic

# Optional. Model to serve. Defaults: claude-haiku-4-5 (Anthropic; $5/MTok
# output = 5 microunits/token, so the demo's 10-microunit price is
# margin-positive) or gpt-5.4-nano (OpenAI).
#INFERENCE_MODEL=claude-haiku-4-5

# Optional. Solana RPC — used ONCE per buyer session (a registration read),
# never on the 402 path. Defaults to the public mainnet RPC; any mainnet RPC
# works. HELIUS_RPC_URL wins if both are set.
#HELIUS_RPC_URL=
#SOLANA_RPC_ENDPOINT=

# Optional. Receive-only payout pubkey (payTo on both rails). No key material
# is ever needed by the server. Defaults to the Dexter demo seller.
#SELLER_PUBKEY=FKF63wLt122SLDNPBfpDgrMcQzxtdLfLyrUS1KziRR1h

# Optional. HTTP port (default 4021).
#PORT=4021

# ── Buyer snippet ────────────────────────────────────────────────────────────

# Where the server runs (default http://localhost:4021).
#SERVER_URL=http://localhost:4021

# oneshot mode (exact rail): base58 private key of a wallet holding USDC.
# Leave unset to watch the payment path fail cleanly with insufficient_funds.
#SOLANA_PRIVATE_KEY=

# tab mode (tab rail): funded Swig-vault credentials — the same set used by
# examples/live-chain/demo-app.
#BUYER_SWIG=
#BUYER_VAULT_PDA=
#PASSKEY_KEY_FILE=./passkey.json
#FEE_PAYER_KEY_FILE=./fee-payer.json

# Optional managed reservation service (default https://x402.dexter.cash).
# FINAL V2 waits for this service to prove the exact reservation finalized.
# This buyer is a server-side CLI. Never expose the internal token in a browser;
# browser apps must proxy this money-side call through an authenticated backend.
#FACILITATOR_URL=https://x402.dexter.cash
#TAB_OPEN_INTERNAL_TOKEN=

# Budget the buyer signs per request / per tab. 0.01 covers the server's
# 1000-token ceiling at 0.000010 USDC per token.
#PER_REQUEST_CAP_USDC=0.01
#TOTAL_TAB_CAP_USDC=0.05
